# 1. Prepared empirical inputs -------------------------------------
# The archive already matches species names, ranges, and interaction records.
# Upstream preparation is explained in the full palm-mammal vignette.
input_dir <- file.path(bundle_dir, "case2")
fit <- readRDS(file.path(input_dir, "fitted-models.rds"))
regional_web <- fit$regional_web
distributions <- list(
producers = rast(file.path(input_dir, "palms.tif")),
consumers = rast(file.path(input_dir, "mammals.tif"))
)
# Normalize formatting as in the source vignette, then align to the matrix.
standardize_species <- function(x) {
x <- gsub("[^[:alnum:]]+", "_", trimws(tolower(x)))
gsub("^_+|_+$", "", x)
}
names(distributions$producers) <- standardize_species(names(distributions$producers))
names(distributions$consumers) <- standardize_species(names(distributions$consumers))
distributions$producers <- distributions$producers[[rownames(regional_web)]]
plot(distributions$producers[[3]])
distributions$consumers <- distributions$consumers[[colnames(regional_web)]]
data.frame(palms = nrow(regional_web), mammals = ncol(regional_web),
regional_links = sum(regional_web))
# The regional matrix and raster species must refer to the same taxa.
# The regional matrix and raster species must refer to the same taxa.
# Range overlap indicates potential co-occurrence, not confirmed encounters.
# 1. Recorded-link baseline --------------------------------------------------
# A recorded regional pair receives 1 wherever both species co-occur.
recorded_model <- probability_matrix_model(
regional_web, row_group = "producers", column_group = "consumers"
)
# 2. Choose how to supply the blocks and their probabilities -----------------
# Run ONE source line. Use the archived fit for the main walkthrough.
# To try another option, comment out the first line and uncomment your choice.
source("model_options/archived.R")
source("model_options/archived.R")
# Each species belongs to a block. Theta describes probabilities between blocks.
# 'guild' here means block membership, not the broad palm or mammal group.
head(producer_lookup)
head(consumer_lookup)
round(theta_sbm, 2)
# MetaWeave uses the supplied parameters; it does not fit the SBM.
sbm_model <- block_model(
row_lookup = producer_lookup,
column_lookup = consumer_lookup,
theta = theta_sbm,
row_group = "producers",
column_group = "consumers"
)
# 3. Compare the same local community under both models ----------------------
assemblages <- assemble_communities(distributions, min_species = 1L)
one_recorded <- infer_networks(assemblages[1], recorded_model)
one_sbm <- infer_networks(assemblages[1], sbm_model)
one_recorded$networks[[1]]$matrix
round(one_sbm$networks[[1]]$matrix, 2)
# 1. Apply both models to the same communities --------------------------------
recorded_networks <- infer_networks(assemblages, recorded_model)
block_networks <- infer_networks(assemblages, sbm_model)
recorded_summary <- summarize_networks(recorded_networks)
block_summary <- summarize_networks(block_networks)
# 2. Match predictions by geographic cell -------------------------------------
# Join using cell_id so each comparison refers to the same location.
recorded_cells <- recorded_summary$index[, c("cell_id", "x", "y", "expected_links")]
block_cells <- block_summary$index[, c("cell_id", "expected_links")]
names(recorded_cells)[4] <- "recorded_links"
names(block_cells)[2] <- "expected_sbm_links"
cells <- merge(recorded_cells, block_cells, by = "cell_id")
# Negative differences mean fewer expected links under the block model.
cells$additional_expected_links <- cells$expected_sbm_links - cells$recorded_links
# 3. Summarize and map the comparison -----------------------------------------
# Compare expected links: sum of each local matrix, binary or probabilistic.
data.frame(cells = nrow(cells),
mean_recorded_links = mean(cells$recorded_links),
mean_expected_sbm_links = mean(cells$expected_sbm_links))
map_data <- rbind(
data.frame(x = cells$x, y = cells$y, model = "Recorded baseline",
links = cells$recorded_links),
data.frame(x = cells$x, y = cells$y, model = "Block model",
links = cells$expected_sbm_links)
)
print(ggplot(map_data, aes(x, y, fill = links)) +
geom_tile() + facet_wrap(~ model) + coord_equal() +
scale_fill_viridis_c() + theme_minimal() +
labs(x = "Longitude", y = "Latitude", fill = "Links",
title = "Same communities; shared colour scale",
subtitle = model_label))
limit <- max(1, abs(cells$additional_expected_links))
print(ggplot(cells, aes(x, y, fill = additional_expected_links)) +
geom_tile() + coord_equal() + theme_minimal() +
scale_fill_gradient2(low = "#2166AC", mid = "white", high = "#B2182B",
limits = c(-limit, limit), midpoint = 0) +
labs(x = "Longitude", y = "Latitude", fill = "Difference",
title = "Expected block-model links minus recorded-baseline links",
subtitle = model_label))

vignette("palm-mammal-workflow", package = "metaweave")
setup_file <- if (file.exists("00_setup.R")) "00_setup.R" else
"lessard_lab_workshop/00_setup.R"
source(setup_file)
library(metaweave)
library(terra)
library(ggplot2)
# 1. Prepared empirical inputs (1 minute) -------------------------------------
# The archive already matches species names, ranges, and interaction records.
# Upstream preparation is explained in the full palm-mammal vignette.
input_dir <- file.path(bundle_dir, "case2")
fit <- readRDS(file.path(input_dir, "fitted-models.rds"))
regional_web <- fit$regional_web
distributions <- list(
producers = rast(file.path(input_dir, "palms.tif")),
consumers = rast(file.path(input_dir, "mammals.tif"))
)
# Normalize formatting as in the source vignette, then align to the matrix.
standardize_species <- function(x) {
x <- gsub("[^[:alnum:]]+", "_", trimws(tolower(x)))
gsub("^_+|_+$", "", x)
}
names(distributions$producers) <- standardize_species(names(distributions$producers))
names(distributions$consumers) <- standardize_species(names(distributions$consumers))
distributions$producers <- distributions$producers[[rownames(regional_web)]]
plot(distributions$producers[[3]])
distributions$consumers <- distributions$consumers[[colnames(regional_web)]]
data.frame(palms = nrow(regional_web), mammals = ncol(regional_web),
regional_links = sum(regional_web))
# 2. Two models, identical communities (2 minutes) ----------------------------
# Baseline: retain recorded regional links wherever both species co-occur.
recorded_model <- probability_matrix_model(regional_web,
row_group = "producers", column_group = "consumers")
if (block_source == "archived") {
producer_lookup <- fit$producer_lookup
consumer_lookup <- fit$consumer_lookup
theta_sbm <- fit$theta_sbm
}
if (block_source == "cassandRa") {
# Fit externally as in the vignette (archived workflow: cassandRa 0.2.0).
# Install cassandRa separately before choosing this option.
# Ten optimization runs are not ten ecological replicates. G = NULL uses
# the implementation's default block-number selection. A new fit may differ.
if (!requireNamespace("cassandRa", quietly = TRUE)) {
stop("Install cassandRa before choosing block_source = 'cassandRa'.")
}
cass_network <- cassandRa::CreateListObject(regional_web)
set.seed(123)
cass_fit <- cassandRa::FitSBM(list = cass_network, n_SBM = 10, G = NULL)
best_sbm <- cass_fit$SBM1
theta_sbm <- best_sbm$Omega_rs
producer_blocks <- paste0("producer_block_", seq_len(nrow(theta_sbm)))
consumer_blocks <- paste0("consumer_block_", seq_len(ncol(theta_sbm)))
dimnames(theta_sbm) <- list(producer_blocks, consumer_blocks)
producer_lookup <- data.frame(
species = rownames(regional_web), guild = producer_blocks[best_sbm$SB_H]
)
consumer_lookup <- data.frame(
species = colnames(regional_web), guild = consumer_blocks[best_sbm$SB_W]
)
}
if (block_source == "manual") {
# Specify memberships AND between-block probabilities yourself.
# Starting assignments below are arbitrary teaching examples, not ecological
# classifications. Replace the species vectors with justified assignments.
# Inspect rownames(regional_web) and colnames(regional_web) for exact names.
# Example syntax: palm_block_2_species <- c("exact_name_1", "exact_name_2")
palm_block_2_species <- rownames(regional_web)[1:2]
mammal_block_2_species <- colnames(regional_web)[1:2]
stopifnot(all(palm_block_2_species %in% rownames(regional_web)),
all(mammal_block_2_species %in% colnames(regional_web)))
# Species outside these vectors are assigned to block 1.
# For more blocks, edit the lookup tables and add corresponding theta rows
# or columns. The 'guild' column here means block membership.
producer_lookup <- data.frame(
species = rownames(regional_web),
guild = ifelse(rownames(regional_web) %in% palm_block_2_species,
"palm_block_2", "palm_block_1")
)
consumer_lookup <- data.frame(
species = colnames(regional_web),
guild = ifelse(colnames(regional_web) %in% mammal_block_2_species,
"mammal_block_2", "mammal_block_1")
)
# Fill in probabilities between 0 and 1: palm blocks in rows, mammal blocks
# in columns. These illustrative numbers are assumptions, not estimates.
theta_sbm <- matrix(
c(0.10, 0.30,   # palm_block_1 with mammal blocks 1 and 2
0.50, 0.20),  # palm_block_2 with mammal blocks 1 and 2
nrow = 2, byrow = TRUE,
dimnames = list(c("palm_block_1", "palm_block_2"),
c("mammal_block_1", "mammal_block_2"))
)
print(producer_lookup)
print(consumer_lookup)
print(theta_sbm)
}
block_source <- "archived"  # Choose "archived", "cassandRa", or "manual".
block_source <- match.arg(block_source, c("archived", "cassandRa", "manual"))
if (block_source == "archived") {
producer_lookup <- fit$producer_lookup
consumer_lookup <- fit$consumer_lookup
theta_sbm <- fit$theta_sbm
}
if (block_source == "cassandRa") {
# Fit externally as in the vignette (archived workflow: cassandRa 0.2.0).
# Install cassandRa separately before choosing this option.
# Ten optimization runs are not ten ecological replicates. G = NULL uses
# the implementation's default block-number selection. A new fit may differ.
if (!requireNamespace("cassandRa", quietly = TRUE)) {
stop("Install cassandRa before choosing block_source = 'cassandRa'.")
}
cass_network <- cassandRa::CreateListObject(regional_web)
set.seed(123)
cass_fit <- cassandRa::FitSBM(list = cass_network, n_SBM = 10, G = NULL)
best_sbm <- cass_fit$SBM1
theta_sbm <- best_sbm$Omega_rs
producer_blocks <- paste0("producer_block_", seq_len(nrow(theta_sbm)))
consumer_blocks <- paste0("consumer_block_", seq_len(ncol(theta_sbm)))
dimnames(theta_sbm) <- list(producer_blocks, consumer_blocks)
producer_lookup <- data.frame(
species = rownames(regional_web), guild = producer_blocks[best_sbm$SB_H]
)
consumer_lookup <- data.frame(
species = colnames(regional_web), guild = consumer_blocks[best_sbm$SB_W]
)
}
if (block_source == "manual") {
# Specify memberships AND between-block probabilities yourself.
# Starting assignments below are arbitrary teaching examples, not ecological
# classifications. Replace the species vectors with justified assignments.
# Inspect rownames(regional_web) and colnames(regional_web) for exact names.
# Example syntax: palm_block_2_species <- c("exact_name_1", "exact_name_2")
palm_block_2_species <- rownames(regional_web)[1:2]
mammal_block_2_species <- colnames(regional_web)[1:2]
stopifnot(all(palm_block_2_species %in% rownames(regional_web)),
all(mammal_block_2_species %in% colnames(regional_web)))
# Species outside these vectors are assigned to block 1.
# For more blocks, edit the lookup tables and add corresponding theta rows
# or columns. The 'guild' column here means block membership.
producer_lookup <- data.frame(
species = rownames(regional_web),
guild = ifelse(rownames(regional_web) %in% palm_block_2_species,
"palm_block_2", "palm_block_1")
)
consumer_lookup <- data.frame(
species = colnames(regional_web),
guild = ifelse(colnames(regional_web) %in% mammal_block_2_species,
"mammal_block_2", "mammal_block_1")
)
# Fill in probabilities between 0 and 1: palm blocks in rows, mammal blocks
# in columns. These illustrative numbers are assumptions, not estimates.
theta_sbm <- matrix(
c(0.10, 0.30,   # palm_block_1 with mammal blocks 1 and 2
0.50, 0.20),  # palm_block_2 with mammal blocks 1 and 2
nrow = 2, byrow = TRUE,
dimnames = list(c("palm_block_1", "palm_block_2"),
c("mammal_block_1", "mammal_block_2"))
)
print(producer_lookup)
print(consumer_lookup)
print(theta_sbm)
}
# Check species coverage, block labels, and probability bounds before inference.
stopifnot(
!anyDuplicated(producer_lookup$species),
!anyDuplicated(consumer_lookup$species),
setequal(producer_lookup$species, rownames(regional_web)),
setequal(consumer_lookup$species, colnames(regional_web)),
!anyNA(producer_lookup$guild), !anyNA(consumer_lookup$guild),
is.matrix(theta_sbm), is.numeric(theta_sbm),
all(is.finite(theta_sbm)), all(theta_sbm >= 0 & theta_sbm <= 1),
!is.null(rownames(theta_sbm)), !is.null(colnames(theta_sbm)),
!anyDuplicated(rownames(theta_sbm)), !anyDuplicated(colnames(theta_sbm)),
all(producer_lookup$guild %in% rownames(theta_sbm)),
all(consumer_lookup$guild %in% colnames(theta_sbm))
)
sbm_model <- block_model(
row_lookup = producer_lookup, column_lookup = consumer_lookup,
theta = theta_sbm, row_group = "producers", column_group = "consumers"
)
# Check species coverage, block labels, and probability bounds before inference.
stopifnot(
!anyDuplicated(producer_lookup$species),
!anyDuplicated(consumer_lookup$species),
setequal(producer_lookup$species, rownames(regional_web)),
setequal(consumer_lookup$species, colnames(regional_web)),
!anyNA(producer_lookup$guild), !anyNA(consumer_lookup$guild),
is.matrix(theta_sbm), is.numeric(theta_sbm),
all(is.finite(theta_sbm)), all(theta_sbm >= 0 & theta_sbm <= 1),
!is.null(rownames(theta_sbm)), !is.null(colnames(theta_sbm)),
!anyDuplicated(rownames(theta_sbm)), !anyDuplicated(colnames(theta_sbm)),
all(producer_lookup$guild %in% rownames(theta_sbm)),
all(consumer_lookup$guild %in% colnames(theta_sbm))
)
sbm_model <- block_model(
row_lookup = producer_lookup, column_lookup = consumer_lookup,
theta = theta_sbm, row_group = "producers", column_group = "consumers"
)
assemblages <- assemble_communities(distributions, min_species = 1L)
one_recorded <- infer_networks(assemblages[1], recorded_model)
one_sbm <- infer_networks(assemblages[1], sbm_model)
one_recorded$networks[[1]]$matrix
round(one_sbm$networks[[1]]$matrix, 2)
# 3. Where do the models disagree? (3 minutes) --------------------------------
# Only the archived model uses saved results. For the other choices, recompute
# both models on the SAME assemblages so the maps reflect the selected model.
if (block_source == "archived") {
cells <- read.csv(file.path(input_dir, "reference_cell_results.csv"))
result_label <- "Archived fitted model: saved landscape results"
} else {
recorded_all <- summarize_networks(infer_networks(assemblages, recorded_model))
sbm_all <- summarize_networks(infer_networks(assemblages, sbm_model))
a <- recorded_all$index
b <- sbm_all$index
stopifnot(identical(a$cell_id, b$cell_id))
cells <- data.frame(cell_id = a$cell_id, x = a$x, y = a$y,
recorded_links = a$expected_links, expected_sbm_links = b$expected_links,
additional_expected_links = b$expected_links - a$expected_links)
result_label <- paste("Reconstructed landscape; block source:", block_source)
}
data.frame(cells = nrow(cells),
mean_recorded_links = mean(cells$recorded_links),
mean_expected_sbm_links = mean(cells$expected_sbm_links))
map_data <- rbind(
data.frame(x = cells$x, y = cells$y, model = "Recorded baseline",
links = cells$recorded_links),
data.frame(x = cells$x, y = cells$y, model = "Block model",
links = cells$expected_sbm_links)
)
print(ggplot(map_data, aes(x, y, fill = links)) +
geom_tile() + facet_wrap(~ model) + coord_equal() +
scale_fill_viridis_c() + theme_minimal() +
labs(x = "Longitude", y = "Latitude", fill = "Links",
title = "Same communities; shared colour scale",
subtitle = result_label))
limit <- max(abs(cells$additional_expected_links))
if (limit == 0) limit <- 1
print(ggplot(cells, aes(x, y, fill = additional_expected_links)) +
geom_tile() + coord_equal() + theme_minimal() +
scale_fill_gradient2(low = "#2166AC", mid = "white", high = "#B2182B",
limits = c(-limit, limit), midpoint = 0) +
labs(x = "Longitude", y = "Latitude", fill = "Difference",
title = "Expected block-model links minus recorded-baseline links",
subtitle = result_label))
# OPTIONAL AFTER THE WORKSHOP: reconstruct the full landscape yourself.
# Switch this flag only when you want the additional computation.
recompute_full_landscape <- TRUE
if (recompute_full_landscape) {
recorded_result <- run_spatial_inference(distributions, recorded_model)
sbm_result <- run_spatial_inference(distributions, sbm_model)
stopifnot(identical(recorded_result$result$index$cell_id,
sbm_result$result$index$cell_id))
print(head(sbm_result$result$index))
}
setup_file <- if (file.exists("00_setup.R")) "00_setup.R" else
"lessard_lab_workshop/00_setup.R"
source(setup_file)
library(ggplot2)
input_dir <- file.path(bundle_dir, "case3")
results <- read.csv(file.path(input_dir, "replicate_summary.csv"))
figure_data <- read.csv(file.path(input_dir, "figure_data.csv"))
contrasts <- read.csv(file.path(input_dir, "paired_contrasts.csv"))
# 2. Compare scenarios (2 minutes) -------------------------------------------
# Each results row is one replicate/scenario mean over REMAINING habitat cells.
# The figure table contains archived means and 95% bootstrap intervals across
# the 30 independent systems. We do not recalculate those intervals here.
print(ggplot(figure_data,
aes(habitat, mean, colour = configuration, linetype = response,
group = interaction(configuration, response))) +
geom_ribbon(aes(ymin = lower, ymax = upper, fill = configuration),
alpha = 0.12, colour = NA, show.legend = FALSE) +
geom_line(linewidth = 0.9) + geom_point(size = 2) +
scale_x_reverse(breaks = c(1, 0.75, 0.5, 0.25)) +
scale_colour_manual(values = c(Aggregated = "#0072B2", Dispersed = "#D55E00")) +
scale_fill_manual(values = c(Aggregated = "#0072B2", Dispersed = "#D55E00")) +
theme_minimal() +
labs(x = "Proportion of habitat remaining", y = "Expected links per remaining cell",
colour = "Configuration", linetype = "Persistence rule",
title = "Fragmentation under two pollinator-persistence assumptions"))
# 3. Separate link counts from connectance (2 minutes) -------------------------
half_habitat <- results[results$habitat == 0.5, ]
aggregate(cbind(expected_links, pollinator_richness, connectance, footprint_links) ~
configuration + response, data = half_habitat, FUN = mean)
# Paired percentage differences: dispersed minus aggregated within each system.
# Negative values indicate a reduction in dispersed habitat.
contrasts[contrasts$habitat == 0.5 &
contrasts$response == "Isolation response" &
contrasts$metric == "expected_links" &
contrasts$scale == "percent", c("mean", "lower", "upper")]
# 4. Interpretation (1 minute) -----------------------------------------------
